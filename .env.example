# Copy to .env and adjust. Never commit .env.

# --- Databases (MariaDB) ---
# App database: read/write, owned by this app (migrations run here).
DATABASE_URL=mysql://birdsquest:CHANGE_ME@127.0.0.1:3306/birdsquest
# Traccar database: the app only needs SELECT on tc_devices and tc_positions.
TRACCAR_DATABASE_URL=mysql://birdsquest_ro:CHANGE_ME@127.0.0.1:3306/traccar
# Dev only: a user that may create the fake Traccar tables (pnpm db:seed). Leave unset in production.
TRACCAR_ADMIN_DATABASE_URL=

# --- LLM (OpenAI-compatible chat completions) ---
# ollama (dev, default) or digitalocean (production).
LLM_PROVIDER=ollama
# Optional. Defaults: ollama -> http://localhost:11434/v1, digitalocean -> https://inference.do-ai.run/v1
LLM_BASE_URL=
# Required for digitalocean: model access key.
LLM_API_KEY=
# Defaults to gemma4:e2b for ollama; required for digitalocean (use the Gemma 4 model id from your DO account).
LLM_MODEL=

# --- Admin ---
# Argon2 hash of the owner password. Escape every $ as \$ (Next.js expands $VARS in .env files).
ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=65536,t=3,p=4\$REPLACE_ME\$REPLACE_ME
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# --- Pipeline tuning (defaults shown) ---
# A trip has ended when its last position is older than this, and a gap this long splits trips.
IDLE_THRESHOLD_MINUTES=10
# Trips shorter than this are ignored.
MIN_TRIP_MINUTES=10
# Minimum GeoModel probability (0-1) for a species to be kept.
PREDICTION_THRESHOLD=0.15
# Maximum species kept per trip.
PREDICTION_TOP_K=20

# --- Tests ---
# Optional. Defaults to DATABASE_URL with "_test" appended to the database name. Tables get truncated!
TEST_DATABASE_URL=
